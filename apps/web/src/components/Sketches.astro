---
const { sketches = [] } = Astro.props;

const featuredSketchbooks = sketches
  .filter((sketchbook: any) => sketchbook.featured === true)
  .sort(
    (a: any, b: any) =>
      new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime()
  )
  .slice(0, 4);
---

<section class="w-full">
  <div class="flex flex-col gap-3 sm:mx-auto">
    <div class="flex items-center justify-between text-human-2 border-b-human-3 border-b-2">
      <h3 class="text-4xl font-medium text-left font-bebas">Lienzos Atrevidos</h3>
      <a href="/sketches" class="underline">
        Ver todos
      </a>
    </div>

    {featuredSketchbooks.length > 0 ? (
      <ul class="flex flex-col sm:grid sm:grid-cols-4 gap-3 px-3">
        {featuredSketchbooks.map((sketchbook: any) => (
          <li>
            <a href={`/${sketchbook.slug}`} class="group block focus:outline-none focus-visible:ring-2 focus-visible:ring-human-3" aria-label={`Ver sketchbook ${sketchbook.title}`}>
              <article class="flex flex-col gap-2">
                <div class="relative aspect-[4/5] overflow-hidden rounded">
                  <img src={sketchbook.cover} alt={sketchbook.coverAlt} class="absolute inset-0 h-full w-full object-cover transition-transform duration-200 group-hover:scale-105" loading="lazy" />
                </div>

                <p class="font-bellota text-sm leading-4 text-human-2">
                  {sketchbook.title}
                </p>
              </article>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="px-3 text-sm text-human-2">
        No hay sketchbooks destacados todavia.
      </p>
    )}
  </div>
</section>
