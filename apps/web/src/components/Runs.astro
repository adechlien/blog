---
type Run = {
  id: string | number;
  stravaUrl: string;
  coverUrl: string;
  coverAlt: string;
};

const { runs = [] } = Astro.props as { runs?: Run[] };
---

{runs.length > 0 && (
  <section class="w-full">
    <div class="flex flex-col gap-4 sm:mx-auto">
      <div class="border-b-2 border-b-human-3 text-human-2">
        <h2 class="text-left font-bebas text-4xl font-medium">Rastros del Mendigo</h2>
      </div>

      <ul class="grid grid-cols-2 gap-3 px-3 sm:grid-cols-3 lg:grid-cols-5">
        {runs.map((run) => (
          <li class="min-w-0">
            <a href={run.stravaUrl} target="_blank" rel="noopener noreferrer" class="block overflow-hidden rounded bg-human-5 focus:outline-none focus-visible:ring-2 focus-visible:ring-human-3" aria-label="Abrir actividad en Strava">
              <div class="aspect-[3/4] overflow-hidden">
                {run.coverUrl && (
                  <img src={run.coverUrl} alt={run.coverAlt} class="h-full w-full object-cover" loading="lazy" decoding="async" />
                )}
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
