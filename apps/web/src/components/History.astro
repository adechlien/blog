---
type DirectusText = {
  id: string;
  title: string;
  pubDate?: string;
  collection?: {
    slug?: string;
    name?: string;
    color?: string;
  };
  cover?: {
    url?: string;
    alt?: string;
  };
};

const { posts = [] } = Astro.props as { posts?: DirectusText[] };

const yearCount: Record<number, number> = {};

posts.forEach((post) => {
  const date = new Date(post.pubDate ?? "");

  if (Number.isNaN(date.getTime())) return;

  const year = date.getFullYear();

  yearCount[year] = (yearCount[year] || 0) + 1;
});

const years = Object.keys(yearCount).map(Number).sort((a, b) => b - a);

---

<aside class="w-full flex flex-col">
  <h2 class="text-4xl font-medium text-left font-bebas text-human-2 border-b-human-3 border-b-2">
    Historial
  </h2>

  <ul class="grid grid-cols-2 sm:grid-cols-4 lg:flex lg:flex-col gap-2 pt-3">
    {years.map((year) => (
      <li>
        <a href={`/${year}`} class="flex justify-between items-center text-human-2 text-2xl font-bebas tracking-wide transition hover:text-human-1 w-full focus:outline-none focus-visible:ring-2 focus-visible:ring-human-3 border-2 border-human-3 px-2 py-1 rounded" aria-label={`Abrir textos del año ${year}`}>
          <span>{year}</span>

          <span class="text-sm font-black text-human-3 font-bellota">
            {yearCount[year]}
          </span>
        </a>
      </li>
    ))}
    <div class="hidden border-human-3 md:border-t-2"></div>
  </ul>
</aside>
