---
import { getCollectionIcon, isMainCollection } from "../lib/collection-ui";

type DirectusCollection = {
  id: string | number;
  name: string;
  slug: string;
  description?: string;
  color?: string;
  icon?: string;
  order?: number;
};

type DirectusText = {
  id: string;
  title: string;
  pubDate?: string;
  collection?: DirectusCollection;
  cover?: {
    url?: string;
    alt?: string;
  };
};

const { posts = [], collections = [] } = Astro.props as {
  posts?: DirectusText[];
  collections?: DirectusCollection[];
};

const sortedCollections = [...collections].filter((collection) => isMainCollection(collection.slug)).sort((a, b) => {
  const orderA = a.order ?? 0;
  const orderB = b.order ?? 0;

  if (orderA !== orderB) return orderA - orderB;

  return a.name.localeCompare(b.name, "es");
});

const countsByType = posts.reduce<Record<string, number>>((acc, post) => {
  const slug = post.collection?.slug;

  if (!slug) return acc;

  acc[slug] = (acc[slug] ?? 0) + 1;

  return acc;
}, {});

---

<div class="flex flex-col">
  <h2 class="text-4xl font-medium text-left font-bebas text-human-2 border-b-human-3 border-b-2">
      Desde mi lado de la acera
  </h2>

  <div class="flex flex-col w-full justify-around gap-4 md:gap-1 pt-3">
    {sortedCollections.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 justify-around w-full gap-2">
        {sortedCollections.map((collection) => {
          const count = countsByType[collection.slug] ?? 0;
          const iconClass = getCollectionIcon(collection.slug);

          return (
            <a href={`/${collection.slug}`} aria-label={`Abrir coleccion ${collection.name}`} class="w-full text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-human-3">
              <article class="overflow-hidden flex flex-row items-center justify-between gap-2 w-full md:border-2 md:border-human-3 md:p-2 rounded-sm">
                <div class="flex items-center gap-2 min-w-0">
                  <i class={`ti ${iconClass} shrink-0 text-lg text-human-3`} aria-hidden="true"></i>

                  <span class="font-bebas font-normal text-lg text-center text-human-2 leading-relaxed truncate">
                    {collection.name}
                  </span>
                </div>

                <span class="inline-flex items-center justify-center text-base font-black text-human-3">
                  {count}
                </span>
              </article>
            </a>
          );
        })}
      </div>
    ) : (
      <p class="text-sm text-human-2">No hay colecciones todavia.</p>
    )}
  </div>
</div>
