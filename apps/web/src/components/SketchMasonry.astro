---
interface Sketch {
  title: string;
  image: {
    url: string;
    alt: string;
  };
  order: number;
}

interface Props {
  sketches: Sketch[];
}

const { sketches } = Astro.props;
---

<section class="w-full">
  <div class="columns-1 gap-5 sm:columns-2 lg:columns-3">
    {
      sketches.map((sketch) => (
        <article class="relative isolate break-inside-avoid">
            <button type="button" class="group w-full text-left" data-sketch-open data-title={sketch.title} data-image={sketch.image.url} data-alt={sketch.image.alt ?? sketch.title} aria-label={`Abrir sketch ${sketch.title}`}>
            <div class="overflow-hidden rounded-lg">
                <img src={sketch.image.url} alt={sketch.image.alt ?? sketch.title} loading="lazy" class="h-auto w-full object-cover"/>
            </div>

            <div class="absolute bottom-0 flex flex-col justify-end px-2 pb-4 pt-12 min-w-full bg-gradient-to-t from-human-4 to-transparent">
              <h3 class="text-human-1 font-bebas text-start text-xl leading-5">
                {sketch.title}
              </h3>
            </div>
          </button>
        </article>
      ))
    }
  </div>

  <div id="sketch-modal" class="fixed inset-0 z-[100] hidden min-h-[100dvh] items-center justify-center bg-human-5/75 px-3 py-4 backdrop-blur-sm sm:px-4 sm:py-6" aria-hidden="true">
    <div class="relative flex max-h-[calc(100dvh-2rem)] max-w-[calc(100vw-1.5rem)] items-center justify-center text-human-2 sm:max-w-[calc(100vw-2rem)]" role="dialog" aria-modal="true">
      <button type="button" id="sketch-modal-close" class="absolute right-3 top-3 z-[60] inline-flex text-2xl leading-none text-human-2 transition hover:text-human-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-human-3" aria-label="Cerrar modal">
        <i class="ti ti-x"></i>
      </button>

      <img id="sketch-modal-image" src="" alt="" class="max-h-[calc(100dvh-2rem)] w-auto max-w-[calc(100vw-1.5rem)] object-contain sm:max-w-[calc(100vw-2rem)] rounded-lg"/>
    </div>
  </div>
</section>


<script is:inline data-astro-rerun>
(() => {
  window.__leggiamoSketchModalController?.abort();

  const controller = new AbortController();
  window.__leggiamoSketchModalController = controller;

  const modal = document.querySelector("#sketch-modal");
  const modalImage = document.querySelector("#sketch-modal-image");
  const closeButton = document.querySelector("#sketch-modal-close");

  const openClass = "flex";
  const closedClass = "hidden";

  const lockPageScroll = () => {
    document.documentElement.classList.add("overflow-hidden");
    document.body.classList.add("overflow-hidden");
  };

  const unlockPageScroll = () => {
    document.documentElement.classList.remove("overflow-hidden");
    document.body.classList.remove("overflow-hidden");
  };

  const closeModal = () => {
    if (!modal) return;

    modal.classList.add(closedClass);
    modal.classList.remove(openClass);
    modal.setAttribute("aria-hidden", "true");
    unlockPageScroll();
  };

  const openModal = (image, alt) => {
    if (!modal) return;

    if (modalImage instanceof HTMLImageElement) {
      modalImage.src = image;
      modalImage.alt = alt;
    }

    modal.classList.remove(closedClass);
    modal.classList.add(openClass);
    modal.setAttribute("aria-hidden", "false");
    lockPageScroll();
  };

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const trigger = target.closest("[data-sketch-open]");
    if (!trigger) return;

    event.preventDefault();

    const image = trigger.getAttribute("data-image") ?? "";
    const alt = trigger.getAttribute("data-alt") ?? "";

    if (trigger instanceof HTMLElement) trigger.blur();

    openModal(image, alt);
  }, { signal: controller.signal });

  closeButton?.addEventListener("click", closeModal, { signal: controller.signal });

  modal?.addEventListener("click", (event) => {
    if (event.target === modal) closeModal();
  }, { signal: controller.signal });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && modal && !modal.classList.contains(closedClass)) closeModal();
  }, { signal: controller.signal });
})();
</script>
