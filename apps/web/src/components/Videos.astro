---
const { videos = [] } = Astro.props;

const featuredVideos = videos
  .filter((video: any) => video.featured === true)
  .sort((a: any, b: any) => (a.order ?? 0) - (b.order ?? 0))
  .slice(0, 6);
---

<section class="w-full">
  <div class="flex flex-col gap-4 sm:mx-auto">
    <div class="flex items-center justify-between text-human-2 border-b-human-3 border-b-2">
      <h2 class="text-4xl font-medium text-left font-bebas">Videos</h2>
      <a href="https://www.youtube.com/@adechlien" target="_blank" rel="noreferrer" class="underline">
        YouTube
      </a>
    </div>

    {featuredVideos.length > 0 ? (
      <ul class="flex flex-col sm:grid sm:grid-cols-3 lg:grid-cols-5 gap-3 px-3">
        {featuredVideos.map((video: any) => {
          const imageUrl = video.thumbnail?.url ?? "";
          const imageAlt = video.thumbnail?.alt ?? video.title;

          return (
            <li>
              <a href={video.youtubeUrl} target="_blank" rel="noreferrer" class="group block focus:outline-none focus-visible:ring-2 focus-visible:ring-human-3" aria-label={`Ver video ${video.title} en YouTube`}>
                <article class="flex flex-col gap-2">
                  <div class="relative aspect-video overflow-hidden rounded">
                    {imageUrl && <img src={imageUrl} alt={imageAlt} class="absolute inset-0 w-full h-full object-cover transition-transform duration-200 group-hover:scale-105" loading="lazy" />}
                  </div>
                </article>
              </a>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="px-3 text-sm text-human-2">
        No hay videos destacados todavia.
      </p>
    )}
  </div>
</section>
