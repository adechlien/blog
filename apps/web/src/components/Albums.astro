---
type Album = {
  id: number;
  apple_music_url: string;
  cover_url: string;
};

const { albums = [] } = Astro.props as { albums?: Album[] };
---

<section class="w-full">
  <div class="flex flex-col gap-4 sm:mx-auto">
    <div class="flex items-center justify-between text-human-2 border-b-human-3 border-b-2">
      <h2 class="text-4xl font-medium text-left font-bebas">Susurros y ecos</h2>
      <a href="https://musicboard.app/adechlien/list/albumes-favoritos/" target="_blank" rel="noopener noreferrer" class="underline">
        Musicboard
      </a>
    </div>

    {albums.length > 0 ? (
      <ul class="grid grid-cols-3 gap-3 px-3">
        {albums.map((album) => (
          <li>
            <a
              href={album.apple_music_url}
              target="_blank"
              rel="noopener noreferrer"
              class="block overflow-hidden rounded-sm bg-human-5 shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-human-3"
              aria-label="Abrir álbum en Apple Music"
            >
              <div class="aspect-square overflow-hidden">
                <img src={album.cover_url} alt="Portada de álbum" class="h-full w-full object-cover" loading="lazy" decoding="async" />
              </div>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="px-3 text-sm text-human-2">No hay álbumes seleccionados todavía.</p>
    )}
  </div>
</section>
