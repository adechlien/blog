---
import TextCard from "./TextCard.astro";
import { isMainCollection } from "../lib/collection-ui";

const { posts = [] } = Astro.props;

const recentPosts = posts
  .filter((post: any) => isMainCollection(post.collection?.slug))
  .slice(0, 3);
---

<section class="w-full min-w-0 flex flex-col gap-3">
  <h2 class="text-4xl font-medium text-left font-bebas text-human-2 border-b-human-3 border-b-2">
    Recientes
  </h2>

  {recentPosts.length > 0 ? (
    <ul class="grid grid-cols-1 md:grid-cols-3 gap-3 px-3">
      {recentPosts.map((post: any) => {
        return (
          <li class="snap-start flex-none">
<TextCard post={post} />
          </li>
        );
      })}
    </ul>
  ) : (
    <p class="mt-4 text-sm text-human-2">No hay textos aún.</p>
  )}
</section>
