---

const { figures = [] } = Astro.props;

const featuredFigures = figures
  .filter((figure: any) => figure.featured === true)
  .sort((a: any, b: any) => (a.order ?? 0) - (b.order ?? 0))
  .slice(0, 5);
---

<section class="w-full">
  <div class="flex flex-col gap-3 sm:mx-auto">
    <h2 class="text-4xl font-medium text-left font-bebas text-human-2 border-b-human-3 border-b-2">
      Ilustres del camino
    </h2>

    {featuredFigures.length > 0 ? (
      <ul class="figures-grid grid gap-3 px-3">
        {featuredFigures.map((figure: any) => {
          const imageUrl = figure.cover?.url ?? "";
          const imageAlt = figure.cover?.alt ?? figure.name;
          const href = `/figures/${figure.slug}`;

          return (
            <li class="min-w-0">
              <a href={href} class="group block w-full text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-human-3" aria-label={`Abrir ilustre ${figure.name}`}>
                <article class="figure-card">
                  <div class="figure-card-cover">{imageUrl && <img src={imageUrl} alt={imageAlt} class="w-full h-full object-cover" loading="lazy" />}</div>

                  <div class="figure-card-body flex flex-col gap-1">
                    <p class="font-bellota text-xs font-bold text-white text-left leading-4">
                      {figure.kind}
                    </p>

                    <p class="font-bebas text-2xl text-white text-left leading-none">
                      {figure.name}
                    </p>
                  </div>
                </article>
              </a>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="px-3 text-sm text-human-2">
        No hay ilustres destacados todavía.
      </p>
    )}
  </div>
</section>

<style>
  .figures-grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); }
  .figure-card { position: relative; border-radius: 12px; box-shadow: 0 5px 16px rgb(0 15 20 / 25%); }
  .figure-card-cover { position: relative; aspect-ratio: 2 / 1; min-height: 120px; overflow: hidden; border-radius: 11px; background: #022A31; }
  .figure-card-cover img { position: absolute; inset: 0; }
  .figure-card-cover::after { content: ""; position: absolute; inset: 0; background: rgb(0 0 0 / 60%); pointer-events: none; }
  .figure-card-body { position: absolute; bottom: 10px; left: 12px; right: 12px; padding: 0; color: #fff; }
</style>
