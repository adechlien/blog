---
const letterboxdProfileUrl = "https://boxd.it/8fVlX";

type PayloadMovie = {
  id: string | number;
  title: string;
  label: string;
  letterboxdUrl: string;
  poster?: {
    url?: string;
    alt?: string;
  };
};

const { movies = [] } = Astro.props as { movies?: PayloadMovie[] };
---

<section class="w-full">
  <div class="flex flex-col gap-4 sm:mx-auto">
    <div class="flex items-center justify-between text-human-2 border-b-human-3 border-b-2">
      <h2 class="text-4xl font-medium text-left font-bebas">
        Claqueta del so&ntilde;ador
      </h2>
      <a href={letterboxdProfileUrl} target="_blank" rel="noopener noreferrer" class="underline">
        Letterboxd
      </a>
    </div>

    {movies.length > 0 ? (
      <ul class="grid grid-cols-2 sm:grid-cols-4 gap-3 px-3">
        {movies.map((movie) => (
          <li>
            <a href={movie.letterboxdUrl} target="_blank" rel="noopener noreferrer" class="group block focus:outline-none focus-visible:ring-2 focus-visible:ring-human-3" aria-label={`Ver ${movie.title} en Letterboxd`}>
              <article class="flex flex-col gap-1 overflow-hidden">
                <div class="relative aspect-[2/3] overflow-hidden rounded bg-human-5">
                  {movie.poster?.url && (
                    <img src={movie.poster.url} alt={movie.poster.alt ?? `Poster de ${movie.title}`} class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
                  )}
                </div>
                <div class="flex flex-col">
                    <span class="font-bebas text-xl text-human-2 leading-none truncate">
                        {movie.title}
                    </span>
                    <span class="font-bellota text-xs text-human-2">
                        {movie.label}
                    </span>
                </div>
              </article>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="px-3 text-sm text-human-2">
        No hay peliculas destacadas todavia.
      </p>
    )}
  </div>
</section>
