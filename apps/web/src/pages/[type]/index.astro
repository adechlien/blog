---
import TextCard from "../../components/TextCard.astro";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getDirectusTexts, getDirectusCollections } from "../../lib/directus";

const type = String(Astro.params.type ?? "");

export const prerender = true;

export async function getStaticPaths() {
  const [data, collectionsData] = await Promise.all([
    getDirectusTexts({ includeContent: false }),
    getDirectusCollections(),
  ]);
  const types = [...new Set([
    ...(collectionsData.docs ?? []).map((collection: any) => collection.slug),
    ...(data.docs ?? []).map((post: any) => post.collection?.slug),
  ].filter(Boolean))];
  return types.map((type) => ({ params: { type } }));
}

const data = await getDirectusTexts({ includeContent: false });
const allPosts = data.docs ?? [];

const posts = allPosts
  .filter((post: any) => post.collection?.slug === type)
  .sort(
    (a: any, b: any) =>
      new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime()
  );

const collectionsData = await getDirectusCollections();
const collection = (collectionsData.docs ?? []).find((collection: any) => collection.slug === type) ?? posts[0]?.collection;
const typeTitle = collection?.name ?? type;
const typeDescription = collection?.description ?? "";

const heroBg = "/banner.svg";
const baseBg = "#024350";
---

<Layout title={typeTitle}>
  <Header />

  <main class="w-full max-w-[1100px] sm:max-w-none flex flex-col gap-16">
    <section class="relative overflow-hidden">
      <div class="relative w-full min-h-[70vh] bg-cover bg-bottom" style={`background-image: url(${heroBg});`}>
        <div class="sm:hidden pointer-events-none absolute inset-x-0 top-0 h-8" style={`background: linear-gradient(to top, rgba(0,0,0,0), ${baseBg});`} />
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-4" style={`background: linear-gradient(to bottom, rgba(0,0,0,0), ${baseBg});`} />
      </div>
    </section>

    <section class="flex flex-col gap-6 px-6 w-full max-w-6xl mx-auto">
      <header class="mb-10 text-human-2">
        <h1 class="text-4xl font-bebas">
          {typeTitle}
        </h1>

        {typeDescription && (
          <p class="text-3xl font-tangerine opacity-80">
            {typeDescription}
          </p>
        )}
      </header>

      {posts.length > 0 ? (
        <ul class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
          {posts.map((post: any) => {
        return (
              <li>
<TextCard post={post} />
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="text-human-2">No hay textos en esta coleccion todavia.</p>
      )}

      <Footer theme="home" />
    </section>
  </main>
</Layout>
