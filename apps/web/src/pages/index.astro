---
import Layout from "../layouts/Layout.astro";
import About from "../components/About.astro";
import Recent from "../components/Recent.astro";
import Collections from "../components/Collections.astro";
import History from "../components/History.astro";
import Destacados from "../components/Destacados.astro";
import Figures from "../components/Figures.astro";
import Videos from "../components/Videos.astro";
import Runs from "../components/Runs.astro";
import Albums from "../components/Albums.astro";
import Movies from "../components/Movies.astro";
import Footer from "../components/Footer.astro";
import { getDirectusAlbums, getDirectusCollections, getDirectusFigures, getDirectusMovies, getDirectusRuns, getDirectusTexts, getDirectusVideos } from "../lib/directus";

export const prerender = true;

const [textsData, figuresData, videosData, moviesData, albumsData, runsData, collectionsData] = await Promise.all([
  getDirectusTexts({ includeContent: false }),
  getDirectusFigures(),
  getDirectusVideos(),
  getDirectusMovies(),
  getDirectusAlbums(),
  getDirectusRuns(),
  getDirectusCollections(),
]);

const posts = textsData.docs ?? [];
const figures = figuresData.docs ?? [];
const videos = videosData.docs ?? [];
const movies = moviesData.docs ?? [];
const albums = albumsData.docs ?? [];
const runs = runsData.docs ?? [];
const collections = collectionsData.docs ?? [];
---

<Layout title="Inicio" description="Blog de textos literarios, prosa y reflexiones personales.">
    <main class="w-full max-w-[1100px] sm:max-w-none">
        <About />
        <section class="w-full px-6">
            <div class="mx-auto flex flex-col gap-12 sm:max-w-[1100px]">
                <Collections posts={posts} collections={collections} />
                <Recent posts={posts} />
                <div class="grid grid-cols-1 lg:grid-cols-[1fr_200px] gap-12 sm:gap-8 h-full">
                    <Destacados posts={posts} />
                    <History posts={posts} />
                </div>
                    <Figures figures={figures} />
                    <Runs runs={runs} />
                    <Videos videos={videos} />
                <div class="flex flex-col lg:grid lg:grid-cols-2 gap-12 lg:gap-8 h-full">
                    <Movies movies={movies} />
                    <Albums albums={albums} />
                </div>
            </div>
        </section>
    </main>
    <Footer theme="home" />
</Layout>
