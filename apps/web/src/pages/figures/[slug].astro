---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getDirectusFigures } from "../../lib/directus";
import { richTextToHtml } from "../../lib/richTextToHtml";

export const prerender = true;

export async function getStaticPaths() {
  const data = await getDirectusFigures();
  const figures = data.docs ?? [];

  return figures
    .filter((figure: any) => figure.slug)
    .map((figure: any) => ({
      params: { slug: figure.slug },
      props: { figure },
    }));
}

const { figure } = Astro.props as { figure: any };

const formatLifeSpan = (figure: any) => {
  if (figure.lifeSpanLabel) return figure.lifeSpanLabel;

  const birthYear = figure.birthDate ? new Date(figure.birthDate).getFullYear() : null;
  const deathYear = figure.deathDate ? new Date(figure.deathDate).getFullYear() : null;

  if (birthYear && deathYear) return `${birthYear}–${deathYear}`;
  if (birthYear && !deathYear) return `${birthYear}–actualidad`;

  return "";
};

const getContributionImageUrl = (image: any) => {
  if (!image?.url) return "";
  return image.url.startsWith("http") ? image.url : "";
};

const bg = figure.backgroundColor ?? "#080809";
const coverUrl = figure.cover?.url ?? "";
const coverAlt = figure.cover?.alt ?? figure.name;
const biographyHtml = richTextToHtml(figure.biography);
const lifeSpan = formatLifeSpan(figure);
const description = figure.isFictional
  ? `Perfil de ${figure.name}, personaje ficticio, en Leggiamo.`
  : `Perfil de ${figure.name} en Leggiamo.`;
---

<Layout title={figure.name} description={description} image={coverUrl || undefined} bg={bg} type="article">
  <Header bg="" />

  <main class="flex min-h-screen w-full flex-col md:flex-row" style={`background-color: ${bg};`}>
    <div class="relative w-full aspect-[2/3] shrink-0 md:sticky md:top-0 md:h-screen md:w-[40vw] md:aspect-auto md:overflow-hidden">
      {coverUrl && <img src={coverUrl} alt={coverAlt} class="h-full w-full object-cover object-center" loading="eager" decoding="async" />}
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-12 md:hidden" style={`background: linear-gradient(to bottom, rgba(0,0,0,0), ${bg});`}></div>
      <div class="pointer-events-none absolute inset-x-0 top-0 h-8 md:hidden" style={`background: linear-gradient(to top, rgba(0,0,0,0), ${bg});`}></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 hidden w-20 md:block" style={`background: linear-gradient(to right, rgba(0,0,0,0), ${bg});`}></div>
    </div>

    <section class="flex w-full flex-col text-human-1 md:flex-1">
      <div class="mx-auto mt-12 flex h-full w-full max-w-[1100px] flex-col px-6 md:mt-10 md:px-10">
        <header class="border-b-2 border-human-1 pb-2">
          {figure.kind && <p class="text-xl capitalize">{figure.kind}</p>}

          <h1 class="font-bebas text-4xl font-medium">
            {figure.name}
          </h1>

          {lifeSpan && (
            <p class="font-besley text-sm">
              ({lifeSpan})
            </p>
          )}
        </header>
        {figure.isFictional && figure.fictionalNotice && (
          <div class="mt-6 rounded-lg border border-human-1/20 bg-black/20 p-4 font-besley text-sm leading-relaxed backdrop-blur-sm">
            {figure.fictionalNotice}
          </div>
        )}

        {biographyHtml && <article lang="es" class="figure-biography py-8 font-besley text-base leading-relaxed text-justify hyphens-auto [&_p]:mb-5 [&_p:last-child]:mb-0 [&_br]:block [&_br]:mb-5" set:html={biographyHtml} />}

        {figure.contributions?.length > 0 && (
          <section class="pb-10">
            <div class="grid grid-cols-1 gap-5 font-besley text-base md:grid-cols-2">
              {figure.contributions.map((item: any) => {
                if (item.blockType === "quote") {
                  return (
                    <article class="break-inside-avoid flex flex-col justify-between gap-4 rounded-lg border border-human-1/20 bg-black/20 p-4 italic leading-relaxed shadow-md backdrop-blur-sm">
                      <p class="text-sm">“{item.text}”</p>

                      {item.source && (
                        <span class="text-right text-xs font-bold not-italic tracking-wide opacity-70">
                          {item.source}
                        </span>
                      )}
                    </article>
                  );
                }

                if (item.blockType === "link") {
                  return (
                    <article class="break-inside-avoid rounded-lg border border-human-1/20 bg-black/20 p-5 leading-relaxed shadow-md backdrop-blur-sm">
                      <h3 class="font-bebas text-2xl">
                        {item.title}
                      </h3>

                      {item.description && (
                        <p class="mt-2 opacity-80">
                          {item.description}
                        </p>
                      )}

                      <a href={item.url} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-2 text-sm font-bold underline">
                        Abrir link
                        <i class="ti ti-external-link"></i>
                      </a>
                    </article>
                  );
                }

                if (item.blockType === "repository") {
                  return (
                    <article class="break-inside-avoid rounded-lg border border-human-1/20 bg-black/20 p-5 leading-relaxed shadow-md backdrop-blur-sm">
                      <div class="mb-3 flex items-center gap-2">
                        <i class="ti ti-brand-github text-xl"></i>

                        <h3 class="font-bebas text-2xl">
                          {item.title}
                        </h3>
                      </div>

                      {item.description && (
                        <p class="opacity-80">
                          {item.description}
                        </p>
                      )}

                      <a href={item.url} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-2 text-sm font-bold underline">
                        Ver repositorio
                        <i class="ti ti-external-link"></i>
                      </a>
                    </article>
                  );
                }

                if (item.blockType === "image") {
                  const contributionImageUrl = getContributionImageUrl(item.image);

                  return (
                    <figure class="break-inside-avoid overflow-hidden rounded-lg border border-human-1/20 bg-black/20 shadow-md">
                      {contributionImageUrl && <img src={contributionImageUrl} alt={item.caption ?? ""} class="w-full object-cover" loading="lazy" />}

                      {item.caption && (
                        <figcaption class="p-3 text-sm opacity-80">
                          {item.caption}
                        </figcaption>
                      )}
                    </figure>
                  );
                }

                if (item.blockType === "note") {
                  const noteHtml = richTextToHtml(item.content);

                  return (
                    <article class="break-inside-avoid rounded-lg border border-human-1/20 bg-black/20 p-5 leading-relaxed shadow-md backdrop-blur-sm">
                      {item.title && (
                        <h3 class="mb-3 font-bebas text-2xl">
                          {item.title}
                        </h3>
                      )}

                      <div set:html={noteHtml} />
                    </article>
                  );
                }

                return null;
              })}
            </div>
          </section>
        )}
        <div class="mt-auto">
          <Footer theme="text" />
        </div>
      </div>
    </section>
  </main>

  <button type="button" aria-label="Volver arriba" class="fixed bottom-5 right-5 z-50 rounded-full border border-human-1 px-3 py-2 text-human-1 opacity-0 transition pointer-events-none" style={`background-color: ${bg};`} onclick="window.scrollTo({ top: 0, behavior: 'smooth' })">
    <i class="ti ti-chevron-up"></i>
  </button>

  <style>
    .figure-biography :global(a) {
      text-decoration: underline;
      font-weight: 700;
    }

    .figure-biography :global(strong) {
      font-weight: 800;
    }
  </style>

  <script is:inline>
    (() => {
      const backToTopButton = document.querySelector('[aria-label="Volver arriba"]');
      if (!backToTopButton) return;

      const updateBackToTopButton = () => {
        const show = window.scrollY >= 300;

        backToTopButton.classList.toggle("opacity-0", !show);
        backToTopButton.classList.toggle("pointer-events-none", !show);
      };

      window.addEventListener("scroll", updateBackToTopButton, { passive: true });
      updateBackToTopButton();
    })();
  </script>
</Layout>
