---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getPayloadSketches } from "../../lib/payload";

const sketchesData = await getPayloadSketches();
const sketchbooks = sketchesData.docs ?? [];

const heroBg = "/banner.svg";
const baseBg = "#024350";
---

<Layout title="Lienzos Atrevidos">
    <Header />
    <main class="w-full max-w-[1100px] sm:max-w-none flex flex-col gap-16">
        <section class="relative overflow-hidden">
            <div class="relative w-full min-h-[70vh] bg-cover bg-bottom" style={`background-image: url(${heroBg});`}>
                <div class="sm:hidden pointer-events-none absolute inset-x-0 top-0 h-8" style={`background: linear-gradient(to top, rgba(0,0,0,0), ${baseBg});`}></div>
                <div class="pointer-events-none absolute inset-x-0 bottom-0 h-4" style={`background: linear-gradient(to bottom, rgba(0,0,0,0), ${baseBg});`}></div>
            </div>
        </section>
        <section class="flex flex-col gap-6 px-6 w-full max-w-6xl mx-auto">
            <header class="mb-10">
                <h1 class="text-4xl font-bebas">Lienzos Atrevidos</h1>
                <p class="text-3xl font-tangerine opacity-80">"."</p>
            </header>
            <div class="flex flex-col gap-16">
                <ul class="grid gap-4 grid-cols-1 sm:grid-cols-4">
                    {sketchbooks.map((sketchbook: any) => (
                        <li>
                            <a href={`/${sketchbook.slug}`} class="block group">
                                <article class="relative isolate overflow-hidden rounded aspect-[2/1]">
                                    <img src={sketchbook.cover?.url} alt={sketchbook.cover?.alt ?? sketchbook.title} class="absolute inset-0 h-full w-full object-cover pointer-events-none select-none transition-transform duration-500 group-hover:scale-105" loading="lazy" />

                                    <div class="absolute bottom-0 flex min-w-full flex-col justify-end px-2 pb-1 pt-12 bg-gradient-to-t from-human-4 to-transparent">
                                        {sketchbook.timeSpan && (
                                            <p class="font-bellota text-xs leading-4 text-human-2">
                                                {sketchbook.timeSpan}
                                            </p>
                                        )}

                                        <h2 class="font-bebas text-lg leading-5 text-human-1">
                                            {sketchbook.title}
                                        </h2>
                                    </div>
                                </article>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
            <Footer theme="home" />
        </section>
    </main>
</Layout>
