---
import TextCard from "../components/TextCard.astro";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { getDirectusTexts } from "../lib/directus";

export const prerender = true;

export async function getStaticPaths() {
  const data = await getDirectusTexts({ includeContent: false });
  const posts = data.docs ?? [];

  const years = Array.from(
    new Set(
      posts
        .map((post: any) => {
          const date = new Date(post.pubDate);
          return Number.isNaN(date.getTime()) ? null : date.getFullYear();
        })
        .filter(Boolean)
    )
  );

  return years.map((year) => ({
    params: { year: String(year) },
  }));
}

const { year } = Astro.params;
const yearNum = Number(year);

const data = await getDirectusTexts({ includeContent: false });
const allPosts = data.docs ?? [];

const posts = allPosts
  .filter((post: any) => {
    const date = new Date(post.pubDate);

    if (Number.isNaN(date.getTime())) return false;

    return date.getFullYear() === yearNum;
  })
  .sort(
    (a: any, b: any) =>
      new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime()
  );

const heroBg = "/banner.svg";
const baseBg = "#024350";
---

<Layout title={`${year}`}>
  <Header />

  <main class="w-full max-w-[1100px] sm:max-w-none flex flex-col gap-16">
    <section class="relative overflow-hidden">
      <div class="relative w-full min-h-[70vh] bg-cover bg-bottom" style={`background-image: url(${heroBg});`}>
        <div class="sm:hidden pointer-events-none absolute inset-x-0 top-0 h-8" style={`background: linear-gradient(to top, rgba(0,0,0,0), ${baseBg});`} />
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-4" style={`background: linear-gradient(to bottom, rgba(0,0,0,0), ${baseBg});`} />
      </div>
    </section>

    <section class="flex flex-col gap-8 px-6 w-full max-w-6xl mx-auto">
      <h1 class="text-4xl font-bebas mb-10">{year}</h1>

      <ul class="grid gap-3 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
        {posts.length ? (
          posts.map((post: any) => {
        return (
              <li>
<TextCard post={post} />
              </li>
            );
          })
        ) : (
          <li>No hay textos en este año.</li>
        )}
      </ul>

      <Footer theme="home" />
    </section>
  </main>
</Layout>
