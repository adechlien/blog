---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import SketchMasonry from "../components/SketchMasonry.astro";
import Footer from "../components/Footer.astro";
import { getPayloadSketches, getPayloadSketchbookBySlug } from "../lib/payload";

export const prerender = true;

export async function getStaticPaths() {
  const data = await getPayloadSketches();
  const sketchbooks = data.docs ?? [];

  return sketchbooks
    .filter((sketchbook: any) => Boolean(sketchbook.slug))
    .map((sketchbook: any) => ({
      params: { sketchbook: sketchbook.slug },
      props: { sketchbook },
    }));
}

const { sketchbook: staticSketchbook } = Astro.props as { sketchbook?: any };
const { sketchbook: slug } = Astro.params;

const sketchbook =
  staticSketchbook ?? (slug ? await getPayloadSketchbookBySlug(slug) : null);

if (!sketchbook) {
  return new Response("Not found", { status: 404 });
}

const heroBg = sketchbook.cover || "/banner.svg";
const baseBg = "#024350";
---

<Layout title={sketchbook.title} description={`Sketchbook ${sketchbook.title}`} image={heroBg}>
  <Header />

  <main class="w-full max-w-[1100px] sm:max-w-none flex flex-col gap-16">
    <section class="relative overflow-hidden">
      <div class="relative w-full min-h-[70vh] bg-cover bg-center" style={`background-image: url(${heroBg});`}>
        <div class="sm:hidden pointer-events-none absolute inset-x-0 top-0 h-8" style={`background: linear-gradient(to top, rgba(0,0,0,0), ${baseBg});`}></div>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-4" style={`background: linear-gradient(to bottom, rgba(0,0,0,0), ${baseBg});`}></div>
      </div>
    </section>

    <section class="flex flex-col gap-6 px-6 w-full max-w-6xl mx-auto">
      <header class="mb-10">
        <h1 class="text-4xl font-bebas">{sketchbook.title}</h1>
        {sketchbook.timeSpan && (
          <p class="text-human-2">{sketchbook.timeSpan}</p>
        )}
      </header>

      <SketchMasonry sketches={sketchbook.sketches ?? []} />
      <Footer theme="home" />
    </section>
  </main>
</Layout>
